# OrbitalAI deployment identity
ORBITAL_ENV=production
ORBITAL_PUBLIC_HOSTNAME=orbital.example.com

# Database
POSTGRES_DB=orbitalai
POSTGRES_USER=orbitalai
POSTGRES_PASSWORD=CHANGE_ME

# Application
ORBITAL_LOG_LEVEL=INFO

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Cloudflare
# Never commit the real token.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

ORBITAL_EPHEMERIS_WARNING_HOURS=12
ORBITAL_EPHEMERIS_STALE_HOURS=24
ORBITAL_EPHEMERIS_MAX_HOURS=72

# Space-Track.org
# Personal account credentials.
# Never commit real values.
SPACE_TRACK_IDENTITY=
SPACE_TRACK_PASSWORD=

# Automatic catalog and ephemeris synchronization.
# The intervals also define each provider cache TTL, so every scheduled run
# requests fresh upstream data when it becomes due.
# Interval, poll and max-record values must be positive integers.
ORBITAL_CATALOG_SYNC_SATCAT_INTERVAL_SECONDS=43200
ORBITAL_CATALOG_SYNC_CELESTRAK_INTERVAL_SECONDS=7200
ORBITAL_CATALOG_SYNC_SPACE_TRACK_INTERVAL_SECONDS=3600

# Scheduler wake-up resolution and CelesTrak ACTIVE ingestion guardrail.
# The group must be non-empty and is normalized to uppercase.
ORBITAL_CATALOG_SYNC_POLL_SECONDS=60
ORBITAL_CATALOG_SYNC_CELESTRAK_GROUP=ACTIVE
ORBITAL_CATALOG_SYNC_CELESTRAK_MAX_RECORDS=40000

# Per-source exponential retry after failed synchronization.
# Delays: 60, 120, 240, ... capped at 1800 seconds.
# Maximum must be at least initial; multiplier must be at least 2.
ORBITAL_CATALOG_SYNC_RETRY_INITIAL_SECONDS=60
ORBITAL_CATALOG_SYNC_RETRY_MAX_SECONDS=1800
ORBITAL_CATALOG_SYNC_RETRY_MULTIPLIER=2

# Screening object guardrail (full canonical Earth catalog).
ORBITAL_SCREENING_MAX_OBJECTS=40000

# Maximum estimated grid SGP4 propagations per run.
# Allows 6 hours at 60-second steps for about 30k objects.
ORBITAL_SCREENING_MAX_PROPAGATIONS=12000000

# Sequential chunks; must be a positive multiple of the grid step.
ORBITAL_SCREENING_CHUNK_SECONDS=900

# Per-chunk guard above the validated ~2.62M / 15-minute baseline.
ORBITAL_SCREENING_MAX_CHUNK_UNIQUE_CANDIDATES=4000000

# Automatic canonical conjunction screening. Cadence is measured from the
# latest successful canonical run persisted in PostgreSQL, including manual runs.
ORBITAL_CONJUNCTION_SCREENING_INTERVAL_SECONDS=14400
ORBITAL_CONJUNCTION_SCREENING_POLL_SECONDS=60

# Exponential retry after scheduler failures: 900, 1800, 3600 seconds, then cap.
ORBITAL_CONJUNCTION_SCREENING_RETRY_INITIAL_SECONDS=900
ORBITAL_CONJUNCTION_SCREENING_RETRY_MAX_SECONDS=3600
ORBITAL_CONJUNCTION_SCREENING_RETRY_MULTIPLIER=2

# Each automatic run keeps the validated six-hour horizon and 60-second grid.
ORBITAL_CONJUNCTION_SCREENING_HOURS=6
ORBITAL_CONJUNCTION_SCREENING_STEP_SECONDS=60
