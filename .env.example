# OrbitalAI deployment identity
ORBITAL_ENV=production
ORBITAL_PUBLIC_HOSTNAME=orbital.example.com

# Database
POSTGRES_DB=orbitalai
POSTGRES_USER=orbitalai
POSTGRES_PASSWORD=CHANGE_ME

# Application
ORBITAL_LOG_LEVEL=INFO

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Cloudflare
# Never commit the real token.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

ORBITAL_EPHEMERIS_WARNING_HOURS=12
ORBITAL_EPHEMERIS_STALE_HOURS=24
ORBITAL_EPHEMERIS_MAX_HOURS=72
