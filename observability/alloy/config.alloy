logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "orbitalai" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "orbitalai" {
  targets = discovery.docker.orbitalai.targets

  rule {
    source_labels = [
      "__meta_docker_container_label_com_docker_compose_project",
    ]

    regex  = "orbitalai"
    action = "keep"
  }

  rule {
    source_labels = [
      "__meta_docker_container_label_com_docker_compose_service",
    ]

    target_label = "service_name"
  }

  rule {
    target_label = "platform"
    replacement  = "orbitalai"
  }
}

loki.source.docker "orbitalai" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.orbitalai.output
  forward_to = [loki.process.orbitalai.receiver]
}

loki.process "orbitalai" {
  stage.label_keep {
    values = [
      "platform",
      "service_name",
    ]
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
