{
  "uid": "orbitalai-operations",
  "title": "OrbitalAI - Orbital Operations Overview",
  "description": "Operational metrics for catalog coverage, deterministic conjunction screening and ingestion. No covariance or collision probability. Cached snapshots refresh every 60 seconds; unavailable collectors retain the last successful values.",
  "tags": [
    "orbitalai",
    "operations"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Platform and worker status",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "orbitalai-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "description": "1 = healthy / successful, 0 = failed. Worker value is the last completed execution, not worker liveness. Database check is the existing /ready probe. Metrics refresh is 1 only when every cached collector's latest refresh succeeded.",
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"orbitalai-api\"}",
          "legendFormat": "API scrape",
          "datasource": {
            "type": "prometheus",
            "uid": "orbitalai-prometheus"
          },
          "instant": true,
          "range": false,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "orbitalai_database_ready",
          "legendFormat": "PostgreSQL",
          "datasource": {
            "type": "prometheus",
            "uid": "orbitalai-prometheus"
          },
          "instant": true,
          "range": false,
          "format": "time_series"
        },
        {
          "refId": "C",
          "expr": "orbitalai_conjunction_last_execution_success{source=\"canonical\"}",
          "legendFormat": "Worker last outcome",
          "datasource": {
            "type": "prometheus",
            "uid": "orbitalai-prometheus"
          },
          "instant": true,
          "range": false,
          "format": "time_series"
        },
        {
          "refId": "D",
          "expr": "min({__name__=~\"orbitalai_(catalog|conjunction|operations|propagation)_metrics_available\"})",
          "legendFormat": "Metrics refresh",
          "datasource": {
            "type": "prometheus",
            "uid": "orbitalai-prometheus"
          },
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
